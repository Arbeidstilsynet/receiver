{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDigest",
    "mergeConfidence:all-badges",
    "group:allNonMajor"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["pinDigest"],
      "automerge": true,
      "description": "Automerge pinDigest PRs (e.g., GitHub Actions)"
    },
    {
      "matchFileNames": ["src/Publish/Receiver.Publish/Receiver.Publish.csproj"],
      "matchPackageNames": ["Microsoft.Extensions.**"],
      "matchCurrentVersion": "<11.0.0",
      "allowedVersions": "<11.0.0",
      "description": "Keep the net10.0 dependency group of the NuGet package on 10.x so .NET 10 consumers keep working"
    }
  ]
}