{
  "name": "receiver-tooling",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "types": "./generated/types.d.ts",
  "exports": {
    ".": {
      "types": "./generated/types.d.ts"
    }
  },
  "scripts": {
    "generate:openapi": "dotnet build Tools/Tools.GenerateOpenApi/Tools.GenerateOpenApi.csproj",
    "generate:ts": "openapi-typescript generated/openApi.json -o generated/types.d.ts",
    "generate:types": "pnpm generate:openapi && pnpm generate:ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  }
}
