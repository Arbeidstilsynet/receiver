{
  "name": "receiver-tooling",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "types": "./src/generated/types.d.ts",
  "exports": {
    ".": {
      "types": "./src/generated/types.d.ts"
    }
  },
  "scripts": {
    "generate:openapi": "dotnet build src/Tools/Tools.GenerateOpenApi/Tools.GenerateOpenApi.csproj",
    "generate:ts": "openapi-typescript src/generated/openApi.json -o src/generated/types.d.ts",
    "generate:types": "pnpm generate:openapi && pnpm generate:ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
