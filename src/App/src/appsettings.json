{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "API": {
    "Authentication": {
      "DangerousDisableAuth": true,
      "TenantId": "not-in-use-when-disabled",
      "ClientId": "not-in-use-when-disabled",
      "Scope": "api://not-in-use-when-disabled/.default"
    }
  },
  "Domain": {
    "AllowOnlyRegisteredApps": true,
    "RequireAltinnDeletionOnUnsubscribe": true
  },
  "Infrastructure": {
    "SkipVirusScan": false,
    "DocumentStorageConfiguration": {
      "AuthRequired": true,
      "BucketName": "test-bucket"
    },
    "MaskinportenConfiguration": {
      "CertificatePrivateKey": "<will-be-replaced-at-runtime>",
      "CertificateChain": "<will-be-replaced-at-runtime>",
      "IntegrationId": "<will-be-replaced-at-runtime>",
      "Scopes": [
        "altinn:serviceowner/instances.read",
        "altinn:serviceowner/instances.write"
      ]
    }
  }
}