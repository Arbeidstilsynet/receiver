{
  "name": "@arbeidstilsynet/receiver",
  "version": "0.0.0",
  "description": "Typed fetch SDK and TypeScript types for the receiver API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arbeidstilsynet/receiver.git",
    "directory": "src/npm_publish"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc6 -p tsconfig.json",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
